    "#write a recursive function to print first n natural number\n",
    "def f1(n):\n",
    "    if n>=0:\n",
    "        f1(n-1)\n",
    "        print(n)\n",
    "    return n+1\n",
    "    \n",
    "print(f1(6))"
   ]
