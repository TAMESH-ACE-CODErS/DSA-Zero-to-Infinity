   "source": [
    "def insertion_sort(list1):\n",
    "    for i in range(1,len(list1)):\n",
    "        temp=list1[i]\n",
    "        j=i-1\n",
    "        while j>=0 and temp<list1[j]:\n",
    "            list1[j+1]=list1[j]\n",
    "            j-=1\n",
    "        list1[j+1]=temp\n",
    "\n",
    "mylist=[25,37,12,11,10,9,39,43,68,91]\n",
    "insertion_sort(mylist)\n",
    "print(mylist)"
   ]
  },
